# Environment variables must be exported by your shell; this file is a reference.
CREWCHECK_DB=data/crewcheck.db
# Use another database instead of the SQLite file above, e.g. PostgreSQL:
# CREWCHECK_DATABASE_URL=postgresql+psycopg://crewcheck:secret@localhost:5432/crewcheck
# Original uploaded files (every attempt, accepted or rejected). Defaults to a 'files' folder next to the database.
CREWCHECK_FILES=data/files
CREWCHECK_SCHEDULER_PASSWORD=SchedulerDemo!2026
CREWCHECK_MANAGER_PASSWORD=ManagerDemo!2026
# Enable only behind HTTPS when deploying beyond localhost.
CREWCHECK_SECURE_COOKIE=0

# Server resource budget, adjustable independently of business rules.
CREWCHECK_MAX_UPLOAD_BYTES=5242880

# Host names the server answers to (comma separated). Add your server name when deploying.
CREWCHECK_ALLOWED_HOSTS=localhost,127.0.0.1
